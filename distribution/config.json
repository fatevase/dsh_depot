{
  "schemaVersion": 1,
  "distributionRepository": "fatevase/dsh_depot",
  "host": {
    "version": "0.2.1-rc.5",
    "node": "26.9.0"
  },
  "candidateFeeds": [
    {
      "type": "github-topic",
      "query": "topic:dsh-plugin"
    }
  ],
  "stateBranch": "distribution-state",
  "publication": {
    "allowUnverified": true
  },
  "registry": "https://registry.npmjs.org",
  "cohort": {
    "id": "maintained-popular-2026-10-19",
    "source": "https://dsh-hub.cc/rankings?lang=zh",
    "capturedAt": "2026-10-19",
    "listFile": "plugin-list.json"
  },
  "pluginList": "plugin-list.json",
  "batchPolicy": {
    "maxPlugins": 5,
    "maxTasks": 15
  },
  "versionPolicy": {
    "host": "npm-latest",
    "plugins": "latest-release-or-tag-otherwise-default-branch",
    "history": "current-only",
    "includeHostPrerelease": true
  }
}
